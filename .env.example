# Copy to .env and fill in from Supabase → Project Settings → API.
# These two are safe for the browser; Row Level Security protects the data.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never prefix the service-role key with PUBLIC_ and never import it in client code.
# Only needed later for server-only tasks such as account deletion (phase 7).
# SUPABASE_SERVICE_ROLE_KEY=
